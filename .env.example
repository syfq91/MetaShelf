# MetaShelf environment configuration
# Copy to .env and fill in values before running.

METASHELF_SECRET_KEY=change-me-to-a-long-random-string
METASHELF_CONFIG_DIR=/config
METASHELF_MEDIA_ROOTS=/media
METASHELF_BASE_URL=
METASHELF_LOG_LEVEL=INFO

# Optional provider API keys (can also be configured in the web UI)
METASHELF_TMDB_API_KEY=

# Docker file ownership
PUID=1000
PGID=1000
TZ=UTC
